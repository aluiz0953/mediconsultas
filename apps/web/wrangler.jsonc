{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "mediconsultas",
  "compatibility_date": "2026-09-29",
  // Static site only: the API stays separate (VITE_API_URL is baked in at build time, see docs/security-deployment.md).
  "assets": {
    "directory": "./dist-cloudflare",
    // Unknown paths get index.html so the React router can show its own 404 page.
    "not_found_handling": "single-page-application"
  }
}
