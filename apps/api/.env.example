DATABASE_URL=postgresql://user:password@localhost:5432/mediconsultas
JWT_SECRET=change-me-to-a-long-random-value

# HMAC key used to derive cpf_hash (uniqueness check without storing CPF in the clear).
CPF_HMAC_SECRET=change-me-to-a-long-random-value

# HMAC key used to derive doctor_profiles.license_hash.
LICENSE_HMAC_SECRET=change-me-to-a-long-random-value

# HMAC key used to hash password-reset/invite tokens before storing them.
RESET_TOKEN_HMAC_SECRET=change-me-to-a-long-random-value

# 32-byte AES-256-GCM key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=change-me-to-a-base64-32-byte-key

PORT=8000
# Interface to bind (empty = all). Use 127.0.0.1 when only a local Cloudflare Tunnel should reach the API.
HOST=

# Extra origins allowed to call the API cross-origin (comma-separated).
# The Android app (Capacitor) runs at http://localhost; the web app uses the Vite proxy and needs none.
CORS_ORIGINS=

# Local testing only — shows the sign-up verification code on screen. NEVER enable in production.
EXPOSE_VERIFICATION_CODE=

# Set to "production" when deployed: enables HSTS, redacts stub e-mail/SMS secrets,
# and the API refuses to start if EXPOSE_VERIFICATION_CODE=true.
NODE_ENV=

# Number of reverse-proxy hops in front of the API (usually 1) so rate limits see the real client IP.
# Leave empty when the API is exposed directly.
TRUST_PROXY=

# Test suites only (e2e, load tests): turns rate limiting off. NEVER set in production.
RATE_LIMIT_DISABLED=

# --- Access control (see docs/security-deployment.md) ---
# Country allow-list (ISO codes, comma-separated). Defaults to BR when NODE_ENV=production; empty disables.
GEO_ALLOWED_COUNTRIES=
# Path to a MaxMind GeoLite2-Country.mmdb (recommended source of the country).
GEOIP_DB_PATH=
# Trust a CDN country header instead (ONLY if the origin accepts CDN traffic exclusively).
GEO_TRUST_HEADER=
GEO_COUNTRY_HEADER=
# Block known VPN ranges (default true in production). Refresh the list with: npm run update:vpn-list -w apps/api
BLOCK_VPN=
VPN_LIST_PATH=
# IPs never geo/VPN-blocked (e.g. the clinic's office), comma-separated.
ACCESS_BYPASS_IPS=
# Tests only: disables IP bans. NEVER set in production.
ABUSE_GUARD_DISABLED=

# --- Database pool ---
# Max connections for this instance (keep below the DB's max_connections / number of instances).
DB_POOL_MAX=
# Queries running longer than this are cancelled (default 15000).
DB_STATEMENT_TIMEOUT_MS=
